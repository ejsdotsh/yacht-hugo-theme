# modified Allowlisting gitignore
# Ignore everything
*

!/.dockerignore
!/.gitignore
!/.gitkeep
!/.github/**/*.yaml
!/.nojekyll

!LICENSE
!VERSION
!Makefile

!README.md
!theme.toml
!config.yaml
!hugo.toml

# one document directory to consolidate them all
!docs/**/*.md

# hugo modules
!go.sum
!go.mod

# npm & webpack
!package.json
!package.hugo.json

# theme components
!archetypes/**
!assets/**
!layouts/**
!static/**

# exampleSite uses a separate .gitignore
!exampleSite/**

# but allow the above files in (sub)directories
!*/

# explicitly ignore experimentation and in-progress development
exp/
.exp/
node_modules/**
package-lock.json
.hugo_build.lock
public/**
resources/
